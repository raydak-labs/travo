{
  "name": "travo-greenfield-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "openapi-ts",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite",
    "build": "vite build && node scripts/gzip-dist.mjs",
    "test": "vitest run",
    "check": "biome check . && svelte-check --tsconfig ./tsconfig.json && vitest run && pnpm build && node scripts/size-budget.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@hey-api/openapi-ts": "0.99.0",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.73.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "bits-ui": "2.21.0",
    "cn": "0.3.3",
    "shadcn-svelte": "1.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
