{
  "name": "openwrt-travel-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modern web UI for OpenWRT travel routers (GL.iNet Beryl AX MT3000, Slate AXT1800)",
  "license": "MIT",
  "scripts": {
    "dev": "make dev",
    "build": "make build",
    "test": "make test",
    "lint": "oxlint --type-aware frontend/src shared/src",
    "lint:ci": "oxlint --type-aware --format=github frontend/src shared/src",
    "format": "prettier --write 'frontend/src/**/*.{ts,tsx}' 'shared/src/**/*.ts' '**/*.{yml,yaml}'",
    "format:check": "prettier --check 'frontend/src/**/*.{ts,tsx}' 'shared/src/**/*.ts' '**/*.{yml,yaml}'",
    "clean": "make clean"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "msw": {
    "workerDirectory": [
      "frontend/public"
    ]
  }
}
