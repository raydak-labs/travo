{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],

  // Only create/update Renovate branches once a week
  "schedule": ["before 4am on monday"],
  "updateNotScheduled": false,

  // Keep majors separate
  "separateMajorMinor": true,
  "separateMultipleMajor": true,

  // Without gomodTidy the gomod manager only appends the new hashes for the
  // versions it bumps, so go.sum keeps the superseded ones and CI's
  // `go mod tidy -diff` gate (test-backend) goes red on the next patch PR.
  "postUpdateOptions": ["gomodTidy"],

  // docker-compose.yml pins node:26-alpine by digest (restored in 5baa9c7 after a
  // tooling commit dropped it while claiming to keep the pin). Renovate updates
  // a digest that is present but does not put one back if it disappears, and
  // nothing in CI fails when the pin is gone, so pinDigests is what makes the
  // supply-chain pin self-healing instead of a one-time courtesy.
  "pinDigests": true,

  "packageRules": [
    {
      // Renovate leaves go.mod's `go` directive alone by default (minimum
      // language version). We pin the exact patch in both .mise.toml and
      // go.mod (TestGoVersionPinsAgree), so bump it when mise's go moves.
      "description": "Bump go.mod go directive in lockstep with the toolchain pin",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
    },
    {
      // matchPackageNames no longer falls back to depName (Renovate 38+).
      // mise's go tool has depName=go / packageName=golang/go, so the old
      // matchPackageNames:["go"] rule never matched and mise-only bumps
      // landed in the catch-all patch group (#190, #213) while go.mod stayed
      // behind. matchDepNames is the right matcher; same groupName merges
      // the docker image rule below.
      "description": "Keep mise + go.mod go pins in one PR",
      "matchManagers": ["mise", "gomod"],
      "matchDepNames": ["go"],
      "groupName": "go toolchain",
      "groupSlug": "go-toolchain",
      "automerge": true,
      "automergeType": "pr",
    },
    {
      "description": "Keep golang docker images with the go toolchain group",
      "matchPackageNames": [
        "golang",
        "docker.io/library/golang",
        "/^golang$/",
      ],
      "groupName": "go toolchain",
      "groupSlug": "go-toolchain",
      "automerge": true,
      "automergeType": "pr",
    },
    {
      // TRACK: Vitest 5's jsdom compat shim resolves jsdom's implementation
      // symbol with `getOwnPropertySymbols(new Blob())[0]` — it assumes the
      // FIRST own symbol is the impl symbol. jsdom 30.1.0 switched wrapper
      // registration to `registerWrapper(wrapper, impl, interfaceDescriptor)`,
      // which adds a different symbol first, so the lookup resolves the
      // descriptor instead and any request whose body contains a File throws
      // "Cannot read properties of undefined (reading '_buffer')". That breaks
      // the upload/backup tests. Drop this rule once Vitest fixes the lookup.
      "description": "Hold jsdom on 30.0.x until Vitest 5 fixes its impl-symbol lookup",
      "matchPackageNames": ["jsdom"],
      "allowedVersions": "<30.1.0",
    },
    {
      "description": "Group all patch/pin/digest updates together",
      "matchUpdateTypes": ["!major", "!minor"],
      // Exclude by depName (mise/gomod go) and packageName (golang images).
      // Negative matchers are ANDed: a dep is excluded if any name matches.
      "matchDepNames": ["!go"],
      "matchPackageNames": ["!golang", "!docker.io/library/golang"],
      "groupName": "all patch/pin/digest updates",
      "groupSlug": "all-patch-pin-digest",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all minor updates together",
      "matchUpdateTypes": ["minor"],
      "groupName": "all minor updates",
      "groupSlug": "all-minor-updates"
    }
  ]
}
